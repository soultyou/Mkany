{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:frontend",
    "dev:api": "API_PORT=3001 npm --workspace=@workspace/api-server run dev",
    "dev:frontend": "npm --workspace=@workspace/mkany-student-housing run dev",
    "build": "npm --workspace=@workspace/api-server run build && npm --workspace=@workspace/mkany-student-housing run build",
    "lint": "npm --workspace=@workspace/mkany-student-housing run typecheck"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "svix": "^1.21.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "esbuild": "0.27.3"
  }
}
